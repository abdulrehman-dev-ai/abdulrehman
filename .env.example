PAYFAST_PRODUCTION_CHECKOUT_URL=https://ipg.apps.net.pk/Ecommerce/api/Transaction/PostTransaction

# Portfolio inquiries (server-side only; never prefix secrets with NEXT_PUBLIC_)
# Verify the sender domain in Resend before turning on direct submissions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
